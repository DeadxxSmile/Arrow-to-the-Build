# Keep line endings consistent so diffs stay clean.
# Source was a mix of LF and CRLF; normalize text to LF in the repo.
# After adding this file once, run:  git add --renormalize .

* text=auto eol=lf

# Windows batch scripts must stay CRLF or cmd.exe can choke.
*.bat text eol=crlf

# Binary assets: never touch.
*.png binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
